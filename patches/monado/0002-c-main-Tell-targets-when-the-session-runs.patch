From 80340372b55c05e21b19602cf67200c18396baef Mon Sep 17 00:00:00 2001
From: Hema2 <49586027+Hema2-official@users.noreply.github.com>
Date: Sat, 10 Oct 2026 14:08:09 +0200
Subject: [PATCH 2/2] c/main: Tell targets when the session runs

An optional comp_target::set_session_running, called when the
compositor's session begins and ends, that is when apps start running
sessions and when the last one stops. For targets whose display only
shows while apps run, like Local Desktop's immersive mode.
---
 src/xrt/compositor/main/comp_compositor.c |  8 ++++++++
 src/xrt/compositor/main/comp_target.h     | 25 +++++++++++++++++++++++
 2 files changed, 33 insertions(+)

diff --git a/src/xrt/compositor/main/comp_compositor.c b/src/xrt/compositor/main/comp_compositor.c
index 3f86972..930939e 100644
--- a/src/xrt/compositor/main/comp_compositor.c
+++ b/src/xrt/compositor/main/comp_compositor.c
@@ -158,6 +158,10 @@ compositor_begin_session(struct xrt_compositor *xc, const struct xrt_begin_sessi
 	}
 	// clang-format on
 
+	if (c->target != NULL) {
+		comp_target_set_session_running(c->target, true);
+	}
+
 	return XRT_SUCCESS;
 }
 
@@ -167,6 +171,10 @@ compositor_end_session(struct xrt_compositor *xc)
 	struct comp_compositor *c = comp_compositor(xc);
 	COMP_DEBUG(c, "END_SESSION");
 
+	if (c->target != NULL) {
+		comp_target_set_session_running(c->target, false);
+	}
+
 	compositor_session_cleanup(c);
 
 	return XRT_SUCCESS;
diff --git a/src/xrt/compositor/main/comp_target.h b/src/xrt/compositor/main/comp_target.h
index abe2220..043506c 100644
--- a/src/xrt/compositor/main/comp_target.h
+++ b/src/xrt/compositor/main/comp_target.h
@@ -323,6 +323,15 @@ struct comp_target
 	 */
 	void (*set_title)(struct comp_target *ct, const char *title);
 
+	/*!
+	 * Optional: the compositor's session began, apps run sessions (@p running true), or it
+	 * ended. For targets whose display only shows while apps run.
+	 *
+	 * @param      ct       The compositor target.
+	 * @param      running  Whether the session runs.
+	 */
+	void (*set_session_running)(struct comp_target *ct, bool running);
+
 	/*!
 	 * Get the available refresh rates for the compositor target
 	 *
@@ -659,6 +668,22 @@ comp_target_set_title(struct comp_target *ct, const char *title)
  * @public @memberof comp_target
  * @ingroup comp_main
  */
+/*!
+ * @copydoc comp_target::set_session_running
+ *
+ * @public @memberof comp_target
+ * @ingroup comp_main
+ */
+static inline void
+comp_target_set_session_running(struct comp_target *ct, bool running)
+{
+	COMP_TRACE_MARKER();
+
+	if (ct->set_session_running != NULL) {
+		ct->set_session_running(ct, running);
+	}
+}
+
 static inline xrt_result_t
 comp_target_get_refresh_rates(struct comp_target *ct, uint32_t *count, float *rates)
 {
